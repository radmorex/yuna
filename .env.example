# Доступ до комп'ютера: програми, музика, повідомлення, екран, мікрофон. Усталено вимкнено.
# Увімкнути можна лише на своєму Mac і лише свідомо.
PC_CONTROL=false

# ─────────────────────────────────────────────────────────────
#  Юна — ИИ-соведущая. Скопируйте в .env и заполните нужное.
#  Пустое значение = функция выключена / используется заглушка.
#  .env в .gitignore — секреты в git не попадут.
# ─────────────────────────────────────────────────────────────

# ── Сервер оверлея ──
# 127.0.0.1 — только этот компьютер (рекомендуется, OBS на этом же ПК).
HOST=127.0.0.1
PORT=8787
# Токен для панели /control и API (заголовок X-Control-Token). Обязателен, если HOST=0.0.0.0.
CONTROL_TOKEN=
# Общий секрет ядра и Discord-бота (сгенерировать: openssl rand -hex 32).
BRIDGE_TOKEN=

# ── Источники чата (через запятую): mock | twitch | discord ──
SOURCES=mock

# ── Мозг (LLM): mock | claude | ollama | anthropic | openai ──
#   claude — через залогиненный CLI `claude`, без ключа и без нагрузки на память. Тратит лимит подписки.
CLAUDE_MODEL=haiku
#   ollama — локальная модель, бесплатно и без ключа (нужен запущенный Ollama)
LLM_PROVIDER=mock
OLLAMA_URL=http://127.0.0.1:11434
# Одновременно держите загруженной только одну модель: две сильно греют ноутбук.
OLLAMA_MODEL=qwen3:8b
# Сколько держать модель в памяти после реплики; потом память освобождается.
OLLAMA_KEEP_ALIVE=3m
# Размер контекста и лимит ответа: чем меньше, тем меньше памяти и быстрее.
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=60
# Ключ Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Бесплатно через Gemini (ключ: https://aistudio.google.com/apikey): LLM_PROVIDER=openai,
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, OPENAI_MODEL=gemini-3.5-flash-lite
# Ключ OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Можно указать любой OpenAI-совместимый сервер (например, локальный).
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Голос (TTS): rvc | piper | edge | none | say | silero | elevenlabs | openai ──
#   rvc   — голос из voices/aria (Aria Blaze): Piper + перекраска RVC, нужно ~1.5 ГБ памяти, поднимается само.
#   piper — открытый локальный голос Irina с аниме-обработкой: без сети и ключей (установка: npm run voice).
#           Лицензия самой модели голоса в карточке указана как Unknown.
#   edge  — нейроголос Microsoft Svetlana, бесплатно, нужен интернет (установка: npm run voice).
#           Неофициальный доступ к сервису: текст уходит в Microsoft, в любой момент может перестать работать.
#   none  — без звука (рот двигается по слогам текста)
#   say   — встроенный голос macOS (Milena), бесплатно, без установки
#   silero — локальный нейроголос, нужен сайдкар tools/silero_server.py (см. tools/SILERO.md)
TTS_PROVIDER=edge
# Голос из voices/: aria или anna. RVC_KEY сдвигает тон в полутонах.
RVC_VOICE=anna
# Базовый голос под RVC: svetlana (живее, нужен интернет, текст уходит в Microsoft) или piper (локально).
RVC_BASE=svetlana
PIPER_MODEL=.cache/piper/ru_RU-irina-medium.onnx
# Обработка голоса ffmpeg. Закомментировано = аниме-пресет, пустое значение = без обработки.
# PIPER_FILTER=
EDGE_TTS_VOICE=uk-UA-PolinaNeural
# Скорость и высота голоса
EDGE_TTS_RATE=+8%
EDGE_TTS_PITCH=+12Hz
# Обработка голоса ffmpeg, по умолчанию без неё. Аниме-пресет: см. ANIME_VOICE_FILTER в core/src/config.rs
# EDGE_TTS_FILTER=
SILERO_URL=http://127.0.0.1:8811
# Женские голоса Silero: xenia, baya, kseniya
SILERO_SPEAKER=xenia
SAY_VOICE=Milena
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys , ID голоса — в Voice Library
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# ── Twitch ──
# Канал, чат которого читаем (без #). Чтение работает анонимно, без токена.
TWITCH_CHANNEL=
# Аккаунт бота, от имени которого Юна пишет в чат (можно ваш основной).
TWITCH_BOT_USERNAME=
# OAuth-токен с правами chat:read chat:edit. Формат: oauth:xxxx или просто xxxx.
TWITCH_OAUTH_TOKEN=
# Для счётчика зрителей (Helix): Client ID приложения с https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
# Если нет OAuth-токена от этого же приложения — Client Secret (получим app-токен сами).
TWITCH_CLIENT_SECRET=
# Писать ли ответы в чат платформы (1/0). 0 — Юна отвечает только на оверлее.
CHAT_REPLY_ENABLED=1

# ── Discord (Python-бот discord_bot/, см. discord_bot/DISCORD.md) ──
DISCORD_TOKEN=
# ID пользователей и ролей с правами админа (через запятую)
DISCORD_ADMIN_USER_IDS=
DISCORD_ADMIN_ROLE_IDS=
# Каналы, где Юна отвечает (пусто = все, где она видит сообщения)
DISCORD_CHANNEL_IDS=
# Голосовой канал: выключен по умолчанию
DISCORD_VOICE_ENABLED=0
DISCORD_VOICE_CHANNEL_ID=
# Адрес ядра для бота
CORE_URL=http://127.0.0.1:8787

# ── Характер и защита ──
# Имя соведущей: на него она откликается и так подписана на оверлее.
BOT_NAME=Юна
# Оно же в винительном падеже: «позови Юну»
BOT_NAME_ACC=Юну
# Другие написания, на которые она откликается (через запятую)
BOT_ALIASES=Yuna
# Ники-админы на всех платформах (через запятую), в дополнение к модераторам Twitch
ADMIN_USERS=
# Пауза между ответами Юны (сек) — анти-спам
REPLY_COOLDOWN_SECS=5
# Один зритель может звать Юну не чаще раза в N секунд и не более M раз в минуту
USER_COOLDOWN_SECS=15
USER_MAX_PER_MINUTE=3
MAX_REPLY_CHARS=500
MAX_INPUT_CHARS=400
# Стоп-слова для ответов (через запятую), заменяются на ***
STOP_WORDS=
MEMORY_FILE=data/memory.json

# ── Прослушивание звука ПК (npm run desktop) ──
# Как часто комментировать, секунд. Каждый комментарий тратит запрос к модели.
COMMENT_INTERVAL_SECS=45
# Модель распознавания: tiny (легче), base, small (точнее, больше памяти)
WHISPER_MODEL=base
# Модель для микрофона: точнее, память занята только на время распознавания. Язык всегда украинский.
WHISPER_MIC_MODEL=small
WHISPER_LANG=uk

# ── Мок-чат (демо) ──
MOCK_CHAT_INTERVAL_MS=2600
MOCK_VIEWERS=100
